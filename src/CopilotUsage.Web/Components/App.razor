<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#050814" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["theme.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["CopilotUsage.Web.styles.css"]" />
    <ImportMap nonce="@Nonce" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["js/glass.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    /// <summary>The per-request nonce the Content-Security-Policy allows for the import map's inline script.</summary>
    private string? Nonce => HttpContext is null ? null : SecurityHeaders.NonceFor(HttpContext);
}
