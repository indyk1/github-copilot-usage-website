@page "/Error"
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization
@using System.Diagnostics

<PageTitle>Something went wrong · Copilot Usage</PageTitle>

@* Shown by the production exception handler (see Program.cs) when a request fails. Never shows exception details. *@
<GlassCard Class="err" aria-labelledby="err-h">
    <Icon Name="alert" Size="28" />
    <h1 id="err-h">Something went wrong</h1>
    <p>The page could not be shown because of an unexpected error. The data is not affected. Try again in a moment; if it keeps happening, tell whoever runs this dashboard.</p>
    @if (!string.IsNullOrEmpty(RequestId))
    {
        <p class="rid">Reference for the logs: <code>@RequestId</code></p>
    }
    <div class="actions">
        <a class="btn btn-primary" href="/">Back to the overview</a>
        <a class="btn" href="/users">All users</a>
    </div>
</GlassCard>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
