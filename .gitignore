# Build output
bin/
obj/
publish/
artifacts/
*.user
*.suo
.vs/
.idea/
TestResults/
*.log

# SQLite databases (never commit data)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/

# Secrets and local settings
*.pfx
.env
.env.*
secrets.json
appsettings.Local.json
appsettings.*.local.json

# Terraform: never commit state, plans, provider downloads or real variable values.
# (.terraform.lock.hcl IS committed: it pins the exact provider build. terraform.tfvars.example is the template.)
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!terraform.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
infra/*.local.*

# Azure Functions local settings (the .example.json file is the template)
local.settings.json
